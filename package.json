{
  "name": "todo-skeleton",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "desktop:dev": "ELECTRON_SERVER_PORT=3210 electron .",
    "desktop:prepare": "node scripts/prepare-electron.cjs",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder --mac"
  },
  "dependencies": {
    "googleapis": "^105.0.0",
    "next": "12.3.4",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "18.19.98",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "electron": "^22.3.27",
    "electron-builder": "^23.6.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.4.5"
  },
  "build": {
    "appId": "com.codex.todo",
    "productName": "Todo Skeleton",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-electron/app",
        "to": "app-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
